diff --git a/internal/runtime/executor/claude_executor_request.go b/internal/runtime/executor/claude_executor_request.go
index 40704c6..8132df8 100644
--- a/internal/runtime/executor/claude_executor_request.go
+++ b/internal/runtime/executor/claude_executor_request.go
@@ -2354,6 +2354,27 @@ func (resolver claudeMCPAliasResolver) resolve(name string) (string, bool, error
 		}
 	}
 
+	// A model may drift the semantic suffix while preserving the keyed tool ID.
+	// IDs are not globally unique: allocation only prevents full-alias collisions.
+	// Recover only after semantic matching fails, and only when this request has
+	// exactly one generated alias with this server and ID. Passthrough tools never
+	// participate. Invalid names and ambiguous semantic matches still fail closed.
+	if validAlias {
+		for _, entry := range resolver.aliases {
+			if entry.parts.server == parts.server && entry.parts.toolID == parts.toolID {
+				matchedOriginal = entry.original
+				matchCount++
+			}
+		}
+		if matchCount == 1 {
+			log.Debugf("claude oauth mcp alias: recovered drifted tool name %q as %q via unique request-local tool ID", name, matchedOriginal)
+			return matchedOriginal, true, nil
+		}
+		if matchCount > 1 {
+			return "", false, claudeMCPAliasRestoreError{fmt.Errorf("cannot restore Claude OAuth MCP tool alias %q: tool ID matches multiple declared tools", name)}
+		}
+	}
+
 	return "", false, claudeMCPAliasRestoreError{fmt.Errorf("cannot restore Claude OAuth MCP tool alias %q: no unique request-local match", name)}
 }
 
