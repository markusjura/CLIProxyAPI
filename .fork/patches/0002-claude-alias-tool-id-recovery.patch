+
+// The incident alias is reproduced with an explicit table; this does not assert
+// which original tool was present in the incident's unavailable request table.
+func TestReverseRemapOAuthToolNamesSemanticDriftByUniqueID(t *testing.T) {
+	const alias = "mcp__select_sight__push_exit_command"
+	tests := []struct {
+		name      string
+		incoming  string
+		reverse   map[string]string
+		want      string
+		wantError bool
+	}{
+		{"unique ID", alias, map[string]string{"mcp__select_sight__push_exec_command": "exec_command"}, "exec_command", false},
+		{"repeated server", "mcp__select_sight__select_sight__push_exit_command", map[string]string{"mcp__select_sight__push_exec_command": "exec_command"}, "exec_command", false},
+		{"ID collision", alias, map[string]string{"mcp__select_sight__push_exec_command": "exec_command", "mcp__select_sight__push_read_file": "read_file"}, "", true},
+		{"unknown ID", "mcp__select_sight__unknown_exit_command", map[string]string{"mcp__select_sight__push_exec_command": "exec_command"}, "", true},
+		{"unknown server", "mcp__other_server__push_exit_command", map[string]string{"mcp__select_sight__push_exec_command": "exec_command"}, "mcp__other_server__push_exit_command", false},
+		{"invalid suffix", alias + "!", map[string]string{"mcp__select_sight__push_exec_command": "exec_command"}, "", true},
+		{"missing suffix", "mcp__select_sight__push_", map[string]string{"mcp__select_sight__push_exec_command": "exec_command"}, "", true},
+		{"exact takes precedence", alias, map[string]string{alias: "exit_command", "mcp__select_sight__push_exec_command": "exec_command"}, "exit_command", false},
+		{"semantic takes precedence", alias, map[string]string{"mcp__select_sight__push_exec_command": "exec_command", "mcp__select_sight__apple_exit_command": "exit_command"}, "exit_command", false},
+		{"ambiguous semantic cannot use ID", alias, map[string]string{"mcp__select_sight__push_exec_command": "exec_command", "mcp__select_sight__apple_exit_command": "exit.one", "mcp__select_sight__banana_exit_command": "exit.two"}, "", true},
+		{"caller tool exact passthrough", alias, map[string]string{alias: alias, "mcp__select_sight__push_exec_command": "exec_command"}, alias, false},
+		{"caller tool excluded from recovery", alias, map[string]string{"mcp__select_sight__push_exec_command": "mcp__select_sight__push_exec_command", "mcp__select_sight__apple_read_file": "read_file"}, "", true},
+		{"another request has no matching ID", alias, map[string]string{"mcp__select_sight__apple_read_file": "read_file"}, "", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			for _, stream := range []bool{false, true} {
+				block := fmt.Sprintf(`{"type":"tool_use","id":"toolu_test","name":%q,"input":{"command":"pwd"}}`, tt.incoming)
+				var restored []byte
+				var err error
+				path := "content.0"
+				if stream {
+					restored, err = reverseRemapOAuthToolNamesFromStreamLine([]byte(`data: {"type":"content_block_start","index":0,"content_block":`+block+`}`), tt.reverse)
+					restored = helps.JSONPayload(restored)
+					path = "content_block"
+				} else {
+					restored, err = reverseRemapOAuthToolNames([]byte(`{"content":[`+block+`]}`), tt.reverse)
+				}
+				if (err != nil) != tt.wantError {
+					t.Fatalf("stream=%v error=%v, wantError=%v", stream, err, tt.wantError)
+				}
+				if err != nil {
+					var scoped interface{ IsRequestScoped() bool }
+					if !errors.As(err, &scoped) || !scoped.IsRequestScoped() {
+						t.Fatalf("error must remain request scoped: %v", err)
+					}
+					continue
+				}
+				if got := gjson.GetBytes(restored, path+".name").String(); got != tt.want {
+					t.Fatalf("stream=%v name=%q, want %q", stream, got, tt.want)
+				}
+				if gjson.GetBytes(restored, path+".input.command").String() != "pwd" {
+					t.Fatal("tool arguments changed")
+				}
+			}
+		})
+	}
+}
