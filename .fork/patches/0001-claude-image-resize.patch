diff --git a/internal/runtime/executor/helps/claude_image_resize.go b/internal/runtime/executor/helps/claude_image_resize.go
new file mode 100644
index 00000000..d8f1f623
--- /dev/null
+++ b/internal/runtime/executor/helps/claude_image_resize.go
@@ -0,0 +1,84 @@
+package helps
+
+import (
+	"bytes"
+	"encoding/base64"
+	"fmt"
+	"image"
+	_ "image/gif"
+	"image/jpeg"
+	"image/png"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+	"golang.org/x/image/draw"
+	_ "golang.org/x/image/webp"
+)
+
+// ResizeClaudeImages limits inline images in outgoing history to Claude's
+// many-image dimensions, even before a request crosses that image-count limit.
+// JSON outside changed image sources is preserved, including numeric precision.
+func ResizeClaudeImages(body []byte) ([]byte, error) {
+	var visit func(gjson.Result, string) error
+	visit = func(blocks gjson.Result, path string) error {
+		for i, block := range blocks.Array() {
+			blockPath := fmt.Sprintf("%s.%d", path, i)
+			if block.Get("type").String() == "tool_result" {
+				if err := visit(block.Get("content"), blockPath+".content"); err != nil {
+					return err
+				}
+			}
+			if block.Get("type").String() != "image" || block.Get("source.type").String() != "base64" {
+				continue
+			}
+			encoded := block.Get("source.data").String()
+			raw, err := base64.StdEncoding.DecodeString(encoded)
+			if err != nil {
+				return fmt.Errorf("%s: invalid base64 image", blockPath)
+			}
+			cfg, format, err := image.DecodeConfig(bytes.NewReader(raw))
+			if err != nil {
+				return fmt.Errorf("%s: cannot read image dimensions: %w", blockPath, err)
+			}
+			if cfg.Width <= 2000 && cfg.Height <= 2000 {
+				continue
+			}
+			// Bound full decoding of untrusted images. Dimension inspection is cheap.
+			if cfg.Width <= 0 || cfg.Height <= 0 || int64(cfg.Width)*int64(cfg.Height) > 100_000_000 {
+				return fmt.Errorf("%s: image exceeds 100 megapixel resize limit", blockPath)
+			}
+			src, _, err := image.Decode(bytes.NewReader(raw))
+			if err != nil {
+				return fmt.Errorf("%s: cannot decode image: %w", blockPath, err)
+			}
+			longest := max(cfg.Width, cfg.Height)
+			width, height := max(1, cfg.Width*2000/longest), max(1, cfg.Height*2000/longest)
+			dst := image.NewNRGBA(image.Rect(0, 0, width, height))
+			draw.ApproxBiLinear.Scale(dst, dst.Bounds(), src, src.Bounds(), draw.Src, nil)
+			var out bytes.Buffer
+			mediaType := "image/png"
+			if format == "jpeg" {
+				mediaType = "image/jpeg"
+				err = jpeg.Encode(&out, dst, &jpeg.Options{Quality: 90})
+			} else {
+				err = png.Encode(&out, dst)
+			}
+			if err != nil {
+				return fmt.Errorf("%s: cannot encode resized image: %w", blockPath, err)
+			}
+			body, err = sjson.SetBytes(body, blockPath+".source", map[string]string{
+				"type": "base64", "media_type": mediaType, "data": base64.StdEncoding.EncodeToString(out.Bytes()),
+			})
+			if err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	for i, message := range gjson.GetBytes(body, "messages").Array() {
+		if err := visit(message.Get("content"), fmt.Sprintf("messages.%d.content", i)); err != nil {
+			return nil, err
+		}
+	}
+	return body, nil
+}
diff --git a/internal/runtime/executor/helps/claude_image_resize_test.go b/internal/runtime/executor/helps/claude_image_resize_test.go
new file mode 100644
index 00000000..24bf2c1a
--- /dev/null
+++ b/internal/runtime/executor/helps/claude_image_resize_test.go
@@ -0,0 +1,86 @@
+package helps
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"image"
+	"image/jpeg"
+	"image/png"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestResizeClaudeImages(t *testing.T) {
+	for _, format := range []string{"png", "jpeg"} {
+		t.Run(format, func(t *testing.T) {
+			var buf bytes.Buffer
+			source := image.NewRGBA(image.Rect(0, 0, 2500, 1000))
+			var err error
+			if format == "jpeg" {
+				err = jpeg.Encode(&buf, source, nil)
+			} else {
+				err = png.Encode(&buf, source)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			block := map[string]any{"type": "image", "source": map[string]string{"type": "base64", "media_type": "image/" + format, "data": base64.StdEncoding.EncodeToString(buf.Bytes())}}
+			// Exercise history, nested tool results, and the >20-image failure trigger.
+			contents := []any{map[string]any{"type": "text", "text": "keep me"}}
+			for range 21 {
+				contents = append(contents, block)
+			}
+			contents = append(contents, map[string]any{"type": "tool_result", "tool_use_id": "tool", "content": []any{block}})
+			payload, err := json.Marshal(map[string]any{"messages": []any{map[string]any{"role": "user", "content": contents}}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			original := bytes.Clone(payload)
+			output, err := ResizeClaudeImages(payload)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(payload, original) {
+				t.Fatal("mutated input history")
+			}
+			for _, path := range []string{"messages.0.content.1.source", "messages.0.content.21.source", "messages.0.content.22.content.0.source"} {
+				raw, err := base64.StdEncoding.DecodeString(gjson.GetBytes(output, path+".data").String())
+				if err != nil {
+					t.Fatal(err)
+				}
+				cfg, actualFormat, err := image.DecodeConfig(bytes.NewReader(raw))
+				if err != nil {
+					t.Fatal(err)
+				}
+				if cfg.Width != 2000 || cfg.Height != 800 || actualFormat != format {
+					t.Fatalf("unexpected image: %+v %s", cfg, actualFormat)
+				}
+			}
+			if gjson.GetBytes(output, "messages.0.content.0.text").String() != "keep me" {
+				t.Fatal("lost text")
+			}
+			again, err := ResizeClaudeImages(output)
+			if err != nil || !bytes.Equal(again, output) {
+				t.Fatal("resizing is not idempotent", err)
+			}
+		})
+	}
+}
+
+func TestResizeClaudeImagesPassThroughAndErrors(t *testing.T) {
+	for _, payload := range []string{
+		`{"messages":[{"role":"user","content":"hello"}],"number":9007199254740993}`,
+		`{"messages":[{"role":"user","content":[{"type":"image","source":{"type":"url","url":"https://example.com/image.png"}}]}]}`,
+	} {
+		output, err := ResizeClaudeImages([]byte(payload))
+		if err != nil || string(output) != payload {
+			t.Fatal("changed unrelated payload", err)
+		}
+	}
+	_, err := ResizeClaudeImages([]byte(`{"messages":[{"content":[{"type":"image","source":{"type":"base64","data":"invalid!"}}]}]}`))
+	if err == nil {
+		t.Fatal("expected invalid image error")
+	}
+}
