diff --git a/internal/runtime/executor/helps/claude_request_size.go b/internal/runtime/executor/helps/claude_request_size.go
new file mode 100644
index 0000000..da090be
--- /dev/null
+++ b/internal/runtime/executor/helps/claude_request_size.go
@@ -0,0 +1,81 @@
+package helps
+
+import (
+	"bytes"
+	"fmt"
+
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const (
+	// Anthropic rejects Messages bodies above 32 MiB with 413 request_too_large.
+	// The budget leaves room for fields added after trimming, such as identity.
+	claudeRequestByteBudget = 30 << 20
+	// Omissions grow in steps so most turns keep the same cached prompt prefix.
+	claudeImageOmissionStep = 8 << 20
+	claudeImageOmittedText  = "[image omitted: request size limit]"
+)
+
+// FitClaudeRequestSize replaces the oldest inline images with a text marker
+// when a Claude request exceeds the upstream size limit. Image-heavy threads
+// can reach that byte limit long before their token count triggers compaction.
+// Requests within the budget are returned unchanged; the input is never mutated.
+func FitClaudeRequestSize(body []byte) []byte {
+	excess := len(body) - claudeRequestByteBudget
+	if excess <= 0 {
+		return body
+	}
+	// Omit whole steps rather than the exact excess. The omitted set then changes
+	// only after another step of growth, since earlier history does not change.
+	target := (excess + claudeImageOmissionStep - 1) / claudeImageOmissionStep * claudeImageOmissionStep
+
+	type replacement struct{ path, marker string }
+	var replacements []replacement
+	saved := 0
+	var visit func(blocks gjson.Result, path string) bool
+	visit = func(blocks gjson.Result, path string) bool {
+		for i, block := range blocks.Array() {
+			if saved >= target {
+				return true
+			}
+			blockPath := fmt.Sprintf("%s.%d", path, i)
+			if block.Get("type").String() == "tool_result" && visit(block.Get("content"), blockPath+".content") {
+				return true
+			}
+			if block.Get("type").String() != "image" || block.Get("source.type").String() != "base64" {
+				continue
+			}
+			marker, _ := sjson.Set(`{"type":"text"}`, "text", claudeImageOmittedText)
+			if cacheControl := block.Get("cache_control"); cacheControl.Exists() {
+				marker, _ = sjson.SetRaw(marker, "cache_control", cacheControl.Raw)
+			}
+			replacements = append(replacements, replacement{blockPath, marker})
+			saved += len(block.Raw) - len(marker)
+		}
+		return saved >= target
+	}
+	for i, message := range gjson.GetBytes(body, "messages").Array() {
+		if visit(message.Get("content"), fmt.Sprintf("messages.%d.content", i)) {
+			break
+		}
+	}
+	if len(replacements) == 0 {
+		return body
+	}
+
+	// Replace in place on one private copy instead of copying the body per image.
+	out := bytes.Clone(body)
+	opts := &sjson.Options{Optimistic: true, ReplaceInPlace: true}
+	for _, r := range replacements {
+		next, err := sjson.SetRawBytesOptions(out, r.path, []byte(r.marker), opts)
+		if err != nil {
+			log.Warnf("claude: cannot omit image at %s: %v", r.path, err)
+			return body
+		}
+		out = next
+	}
+	log.Infof("claude: omitted %d oldest images to reduce request from %d to %d bytes", len(replacements), len(body), len(out))
+	return out
+}
diff --git a/internal/runtime/executor/helps/claude_request_size_test.go b/internal/runtime/executor/helps/claude_request_size_test.go
new file mode 100644
index 0000000..eed9009
--- /dev/null
+++ b/internal/runtime/executor/helps/claude_request_size_test.go
@@ -0,0 +1,77 @@
+package helps
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestFitClaudeRequestSize(t *testing.T) {
+	image := func(extra map[string]any) map[string]any {
+		block := map[string]any{"type": "image", "source": map[string]string{"type": "base64", "media_type": "image/png", "data": strings.Repeat("A", 1<<20)}}
+		for key, value := range extra {
+			block[key] = value
+		}
+		return block
+	}
+	// Each user turn carries one image, alternating between plain and tool-result images.
+	history := func(turns int) []byte {
+		var messages []any
+		for i := range turns {
+			block := image(nil)
+			if i == 0 {
+				block = image(map[string]any{"cache_control": map[string]string{"type": "ephemeral"}})
+			}
+			if i%2 == 1 {
+				block = map[string]any{"type": "tool_result", "tool_use_id": "tool", "content": []any{block}}
+			}
+			messages = append(messages, map[string]any{"role": "user", "content": []any{map[string]any{"type": "text", "text": "turn"}, block}})
+		}
+		body, err := json.Marshal(map[string]any{"model": "claude", "messages": messages, "number": json.Number("9007199254740993")})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return body
+	}
+	omitted := func(body []byte) int {
+		return strings.Count(string(body), claudeImageOmittedText)
+	}
+
+	small := history(29)
+	if output := FitClaudeRequestSize(small); !bytes.Equal(output, small) {
+		t.Fatal("changed a request within budget")
+	}
+
+	large := history(40)
+	original := bytes.Clone(large)
+	output := FitClaudeRequestSize(large)
+	if !bytes.Equal(large, original) {
+		t.Fatal("mutated input")
+	}
+	if len(output) > claudeRequestByteBudget || !json.Valid(output) {
+		t.Fatalf("invalid or oversized output: %d bytes", len(output))
+	}
+	// 10 MiB excess rounds up to two 8 MiB steps, taken from the oldest images.
+	if got := omitted(output); got != 16 {
+		t.Fatalf("omitted %d images, want 16", got)
+	}
+	if gjson.GetBytes(output, "messages.0.content.1.cache_control.type").String() != "ephemeral" ||
+		gjson.GetBytes(output, "messages.1.content.1.content.0.text").String() != claudeImageOmittedText ||
+		gjson.GetBytes(output, "messages.16.content.1.type").String() != "image" ||
+		gjson.GetBytes(output, "messages.39.content.1.content.0.type").String() != "image" ||
+		gjson.GetBytes(output, "messages.0.content.0.text").String() != "turn" ||
+		gjson.GetBytes(output, "number").Raw != "9007199254740993" {
+		t.Fatal("unexpected replacement")
+	}
+
+	// Growth within the same step keeps the omitted prefix, and the prompt cache.
+	if got := omitted(FitClaudeRequestSize(history(45))); got != 16 {
+		t.Fatalf("omitted %d images after growth within a step, want 16", got)
+	}
+	if got := omitted(FitClaudeRequestSize(history(47))); got != 24 {
+		t.Fatalf("omitted %d images after crossing a step, want 24", got)
+	}
+}
